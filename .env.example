# Copy to .env (optional - everything has a sensible default)
PORT=3000
# Folder where the SQLite database file is stored. Mount a persistent disk/volume here in production.
DATA_DIR=./data
# Set to "true" when serving over HTTPS (production) so the session cookie is Secure.
COOKIE_SECURE=false
# Comma-separated list of allowed origins if the frontend is hosted on a DIFFERENT domain. Leave empty for same-origin.
CORS_ORIGINS=
